{
  "name": "@unforked/backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "bin": {
    "unforked-backend": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:server": "tsx src/e2e-server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "kysely": "^0.29.7",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
