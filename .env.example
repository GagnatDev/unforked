# Database (for local run when Postgres is in docker-compose). Host port moved
# off the platform-default 5432 to avoid colliding with other homectl apps'
# local Postgres containers.
DATABASE_URL=postgresql://meals:meals@localhost:5632/meals

# Backend. Host port moved off the platform-default 8080 to avoid colliding
# with other homectl apps' local backends.
PORT=8082
CORS_ORIGIN=http://localhost:3002

# Machine API (API-key-authenticated /machine/v1 routes, docs/aivo-integration.md)
# - a separate listener/port from PORT above. Moved off the code default of
# 8081 (collides with aivo's local dev backend) and off 8083 (collides with
# mygarden's local dev backend workspace-wide — see
# homectl-reference/docs/local-ports.md). Production/k8s keeps the 8081
# default; see k8s/deployment.yml.
MACHINE_PORT=8086

# Frontend (when running Node server locally)
# BACKEND_URL=http://localhost:8082
# PORT=3002

# Frontend dev (Vite proxy targets backend; optional override)
# VITE_API_URL=

# Auth: production identity comes from the homectl-auth sidecar's headers.
# Locally there is no sidecar - disable auth to use the fixed dev admin
# (do not set in production):
# DISABLE_AUTH=true

# One-time homectl-auth user import at boot (set all three or none; production
# gets them from the unforked-terraform-secrets Secret). Values below are
# local-dev placeholders for homectl-auth's dev registration of this app.
# NOTE: setting these three activates the boot-time import against
# INTERNAL_AUTH_URL - only uncomment/keep them active if you actually have
# homectl-auth running locally on :4400 (see its dev OAuth registration for
# "unforked", client id "unforked"); otherwise the app fails to boot when it
# can't reach the import endpoint. Comment all three out for plain local dev
# with DISABLE_AUTH=true and no homectl-auth running.
AUTH_CLIENT_ID=unforked
# "dev-secret" is a placeholder matching homectl-auth's convention for its
# other dev-registered apps - replace with whatever homectl-auth's local
# config/apps.json / .env.dev actually assigns for the "unforked" client.
AUTH_CLIENT_SECRET=dev-secret
# Local dev: homectl-auth's dev API port. In production this is the
# in-cluster-only http://homectl-auth.homectl (see docs/auth-sidecar-migration.md).
INTERNAL_AUTH_URL=http://localhost:4400
